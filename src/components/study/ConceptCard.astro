---
import { t, translate, translatePatternTitle } from '../../lib/translations';
import ConceptSource from './ConceptSource.astro';
import Icon from '../Icon.astro';
import LearnButton from './LearnButton.astro';
import ConceptViewTabs from './ConceptViewTabs.astro';
import ImplementationGuide from './ImplementationGuide.astro';
import { patternGuides } from '../../data/pattern-guides/index';
import { createConceptViews } from '../../lib/concept-views';
import type { Concept } from '../../data/curriculum';
interface Props { concept: Concept; index: number; isPattern?: boolean; searchAliases?: string; hideEmptyViews?: boolean }
const { concept, index, isPattern = false, searchAliases, hideEmptyViews = false } = Astro.props;
const isSolid = concept.id.startsWith('solid-');
const hasPlainNumber = isPattern || isSolid;
const views = createConceptViews(concept);
const guide = isPattern ? patternGuides[concept.id] : undefined;
const implementationDialogId = guide ? `implementation-${concept.id}` : undefined;
---
<article class="concept-card" id={`concept-${concept.id}`} data-concept-id={concept.id} data-level={concept.level} data-search-aliases={searchAliases}>
                <div class="card-top"><div class:list={["card-heading", { "card-heading-pattern": hasPlainNumber }]}><span class:list={["concept-number", { "concept-number-plain": hasPlainNumber }]}>{hasPlainNumber ? <><span>{String(index + 1).padStart(2, '0')}</span><Icon name="dot" size={3} /></> : String(index + 1).padStart(2, '0')}</span><h3 class:list={{ 'solid-title': isSolid }} data-i18n-source={isPattern || isSolid ? undefined : concept.title} data-pattern-title={isPattern ? concept.title : undefined} lang={isPattern ? 'en' : undefined} translate={isPattern ? 'no' : undefined}>{isSolid ? <><span class="solid-initial">{concept.title.slice(0, 3)}</span>{' '}<span data-i18n-es={translate(concept.title, 'es').slice(4)} data-i18n-en={translate(concept.title, 'en').slice(4)}>{t(concept.title).slice(4)}</span></> : isPattern ? translatePatternTitle(concept.title, 'en') : t(concept.title)}</h3></div><span class={`level-badge level-${concept.level.toLowerCase()}`}>{t(concept.level)}</span></div>
                <div class="concept-description" aria-live="polite" aria-atomic="true">
                  {views.filter(view => !(guide && view.id === 'example')).map(view => <div id={`concept-${concept.id}-${view.id}`} data-card-panel={view.id} hidden={!view.active}><p data-i18n-es={guide && view.id === 'use-case' ? guide.useCase.es : undefined} data-i18n-en={guide && view.id === 'use-case' ? guide.useCase.en : undefined}>{guide && view.id === 'use-case' ? guide.useCase.en : t(view.content)}</p></div>)}
                </div>
                <ConceptSource source={concept.source} conceptTitle={concept.title} />
                <div class="card-footer">
                  <ConceptViewTabs views={views} conceptId={concept.id} title={concept.title} implementationDialogId={implementationDialogId} hidden={hideEmptyViews && !concept.useCase?.trim() && !concept.example?.trim()} />
                  <LearnButton conceptId={concept.id} />
                </div>
                {guide && <ImplementationGuide guide={guide} conceptId={concept.id} title={concept.title} />}
              </article>
