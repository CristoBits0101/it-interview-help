---
import { t, translatePatternTitle } from '../../lib/translations';
import Icon from '../Icon.astro';
import type { PatternGuide } from '../../data/pattern-guides/types';
import '../../styles/implementation-guide.css';

interface Props { guide: PatternGuide; conceptId: string; title: string }
const { guide, conceptId, title } = Astro.props;
const id = `implementation-${conceptId}`;
const lines = guide.code.split('\n');
---
<dialog class="implementation-dialog" id={id} aria-labelledby={`${id}-title`} data-implementation>
  <header class="implementation-header">
    <h2 id={`${id}-title`} data-pattern-title={title} lang="en" translate="no" tabindex="-1">{translatePatternTitle(title, 'en')}</h2>
    <div class="implementation-headings">
      {guide.steps.map((step, index) => <h3 data-i18n-es={step.title.es} data-i18n-en={step.title.en} data-guide-heading={index} id={`${id}-heading-${index}`} hidden={index !== 0}>{step.title.en}</h3>)}
    </div>
    <button class="icon-button" type="button" data-close-dialog aria-label={t('Cerrar implementación')}><Icon name="close" size={20} /></button>
  </header>

  <div class="implementation-body">
    <div class="implementation-step-intro">
      <div>
        {guide.steps.map((step, index) => <p data-i18n-es={step.why.es} data-i18n-en={step.why.en} class="implementation-why" data-guide-why={index} hidden={index !== 0}>{step.why.en}</p>)}
      </div>
    </div>

    {guide.steps.map((step, index) => <section data-guide-step={index} id={`${id}-step-${index}`} aria-labelledby={`${id}-heading-${index}`} hidden={index !== 0}>
      <div class="implementation-code" tabindex="0" role="region" aria-label={t('Código de este paso')}>
        <pre translate="no"><code>{lines.slice(step.from - 1, step.to).map((line, offset) => <span class:list={['implementation-code-line', { 'is-key': step.focus.includes(step.from + offset) }]}><span class="implementation-line-number">{step.from + offset}</span>{line || ' '}</span>)}</code></pre>
      </div>
      {index === guide.steps.length - 1 && <div class="implementation-output"><p>{t('Salida esperada')}</p><pre translate="no"><code>{guide.output}</code></pre></div>}
    </section>)}

    <details class="implementation-complete">
      <summary>{t('Ver código completo')}</summary>
      <div class="implementation-copy-row"><span translate="no">Main.java</span><button type="button" class="implementation-control" data-guide-copy><Icon name="copy" size={16} /><span>{t('Copiar código')}</span></button></div>
      <div class="implementation-code" tabindex="0" role="region" aria-label={t('Código completo')}><pre translate="no"><code data-guide-code>{guide.code}</code></pre></div>
      <p class="implementation-copy-status" data-copy-status role="status"></p>
    </details>
  </div>

  <footer class="implementation-footer">
    <button type="button" class="implementation-control" data-guide-previous disabled><Icon name="chevron" size={16} class="implementation-back" /><span>{t('Anterior')}</span></button>
    <ol class="implementation-index" aria-label={t('Pasos de implementación')}>
      {guide.steps.map((step, index) => <li><button type="button" data-guide-go={index} aria-current={index === 0 ? 'step' : undefined} aria-controls={`${id}-step-${index}`} title={step.title.en} data-i18n-es={step.title.es} data-i18n-en={step.title.en} data-i18n-attribute="title">{index + 1}<span class="sr-only" data-i18n-es={` ${step.title.es}`} data-i18n-en={` ${step.title.en}`}> {step.title.en}</span></button></li>)}
    </ol>
    <button type="button" class="implementation-control" data-guide-next disabled={guide.steps.length < 2}><span>{t('Siguiente')}</span><Icon name="chevron" size={16} /></button>
  </footer>
</dialog>
