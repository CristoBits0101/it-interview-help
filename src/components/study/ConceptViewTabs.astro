---
import type { ConceptView } from '../../lib/concept-views';
interface Props { views: ConceptView[]; conceptId: string; title: string; hidden?: boolean }
const { views, conceptId, title, hidden = false } = Astro.props;
---
<div class="card-views" role="group" aria-label={`Contenido de ${title}`} hidden={hidden}>
                    {views.map(view => <button type="button" class="card-view-button" data-card-view={view.id} aria-controls={`concept-${conceptId}-${view.id}`} aria-pressed={view.active ? 'true' : 'false'} disabled={!view.content}>{view.label}</button>)}</div>
