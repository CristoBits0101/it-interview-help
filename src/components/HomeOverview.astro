---
import type { Track } from '../data/curriculum';
import { navigation } from '../data/navigation';
import { careerProfiles, areaGuidance, careerBranches, careerTermDescriptions } from '../data/career-paths';
import HomeStats from './home/HomeStats.astro';
import CareerPaths from './home/CareerPaths.astro';
import CareerGrowth from './home/CareerGrowth.astro';
import { flattenNavigation, countConcepts } from '../lib/catalog';
import '../styles/home.css';

interface Props { tracks: Track[] }
const { tracks } = Astro.props;
const catalog = flattenNavigation(navigation);
const areas = new Map(catalog.map(node => [node.label, node]));
const totalConcepts = tracks.reduce((total, track) => total + countConcepts(track), 0);
const stats = [
  { value: navigation.length, label: 'Áreas Principales', detail: 'Temas para repasar' },
  { value: tracks.length, label: 'Rutas con Contenido', detail: 'Disponibles para estudiar' },
  { value: totalConcepts, label: 'Conceptos', detail: 'Breves y conectados' },
  { value: careerProfiles.length, label: 'Perfiles Profesionales', detail: 'Un camino para cada objetivo' },
];
---

<section id="home-view" aria-labelledby="home-title">
  <h1 id="home-title" class="sr-only">Inicio</h1>

  <HomeStats stats={stats} />
  <hr class="home-separator" />

  <CareerPaths profiles={careerProfiles} tracks={tracks} areas={areas} guidanceByArea={areaGuidance} termDescriptions={careerTermDescriptions} />
  <hr class="home-separator" />

  <CareerGrowth branches={careerBranches} />
</section>
