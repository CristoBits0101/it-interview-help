---
import Icon from '../Icon.astro';
import NavigationTree from '../NavigationTree.astro';
import AvailabilitySwitch from '../controls/AvailabilitySwitch.astro';
import type { NavigationNode } from '../../data/navigation';
interface Props { nodes: NavigationNode[] }
const { nodes } = Astro.props;
---
<div class="sidebar" id="sidebar" role="complementary" aria-label="Navegación de aprendizaje">
      <div class="sidebar-header">
        <a href="#home" class="brand" aria-label="Tech Interview Prep. Inicio" lang="en"><span>Tech Interview Prep</span></a>
        <button class="icon-button sidebar-close" id="sidebar-close" aria-label="Cerrar menú de rutas"><Icon name="close" /></button>
      </div>
      <div class="navigation-section">
        <div class="navigation-heading-row"><p class="nav-eyebrow" id="navigation-heading" lang="en">FOUNDATIONS BY AREA</p><AvailabilitySwitch /></div>
        <nav id="course-navigation" class="course-nav" aria-labelledby="navigation-heading" lang="en">
          <NavigationTree nodes={nodes} />
        </nav>
      </div>
    </div>
