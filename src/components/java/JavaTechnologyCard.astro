---
import type { JavaTechnology } from '../../data/java-ecosystem';
import { javaEcosystemSources } from '../../data/concept-sources';
import { t } from '../../lib/translations';
import Text from '../LocalizedText.astro';
import Icon from '../Icon.astro';
import ConceptSource from '../study/ConceptSource.astro';
interface Props { technology: JavaTechnology }
const { technology } = Astro.props;
---
<article class="java-ecosystem-card" data-java-technology={technology.id}>
  <header><h3>{t(technology.name)}</h3><Text as="p" value={technology.outcome} /></header>
  <details class="java-technology-roadmap">
    <summary><span>{t('Technology Roadmap')}</span>{' '}<span class="sr-only">{t(technology.name)}</span><Icon name="down" size={16} /></summary>
    <dl>
      <div><dt>{t('Lo que necesitas')}</dt><dd><Text value={technology.need} /></dd></div>
      <div><dt>{t('Combinación')}</dt><dd><span>Java + </span><span>{t(technology.name)}</span></dd></div>
      <div><dt>{t('Lo que obtienes')}</dt><dd><Text value={technology.outcome} /></dd></div>
    </dl>
    {['hibernate', 'spring-data-jpa'].includes(technology.id) && <button type="button" class="learning-guide-trigger" data-open-guide="hibernate-loading-guide" aria-haspopup="dialog" aria-controls="hibernate-loading-guide">{t('Lazy vs Eager Loading')}<Icon name="arrow" size={16} /></button>}
  </details>
  <div class="java-technology-sources">
    {technology.sourceIds.map(id => <ConceptSource source={javaEcosystemSources[id]} conceptTitle={technology.name} />)}
  </div>
</article>
