---
import { javaTechnologies, springTechnologies, javaArchitecture, javaCareerPaths, javaDeveloperRoadmap } from '../../data/java-ecosystem';
import { t } from '../../lib/translations';
import Text from '../LocalizedText.astro';
import Icon from '../Icon.astro';
import JavaTechnologyCard from './JavaTechnologyCard.astro';
import '../../styles/java-learning-paths.css';
---
<section id="java/ecosystem" class="java-path-page" data-resource-route="java/ecosystem" data-resource-title="Ecosystem" aria-labelledby="java-ecosystem-title" hidden>
  <header class="java-path-heading">
    <h1 id="java-ecosystem-title">{t('Ecosystem')}</h1>
    <Text as="p" value={{ es: 'Explora qué puedes construir con Java y cada tecnología. Las rutas tecnológicas relacionan necesidades y resultados sin fijar un orden de aprendizaje.', en: 'Explore what you can build with Java and each technology. Technology roadmaps connect needs and outcomes without prescribing a learning order.' }} />
  </header>
  <div class="java-path-group">
    <h2>{t('Tecnologías para Java')}</h2>
    <div class="java-ecosystem-grid">{javaTechnologies.map(technology => <JavaTechnologyCard technology={technology} />)}</div>
  </div>
  <div class="java-path-group">
    <h2>Spring + Java</h2>
    <Text as="p" value={{ es: 'Herramientas para distintas necesidades de aplicaciones Java con Spring. JUnit y Mockito son herramientas de pruebas independientes.', en: 'Tools for different needs of Java applications with Spring. JUnit and Mockito are independent testing tools.' }} />
    <div class="java-ecosystem-grid">{springTechnologies.map(technology => <JavaTechnologyCard technology={technology} />)}</div>
  </div>
  <div class="java-path-group">
    <h2>{t('Estilos Arquitectónicos')}</h2>
    <Text as="p" value={{ es: 'Los microservicios describen cómo organizar un sistema. Son un estilo arquitectónico y no una biblioteca de Java.', en: 'Microservices describes how to organize a system. It is an architectural style rather than a Java library.' }} />
    <div class="java-ecosystem-grid"><JavaTechnologyCard technology={javaArchitecture} /></div>
  </div>
</section>

<section id="java/career-paths" class="java-path-page" data-resource-route="java/career-paths" data-resource-title="Career Paths" aria-labelledby="java-career-paths-title" hidden>
  <header class="java-path-heading">
    <h1 id="java-career-paths-title">{t('Career Paths')}</h1>
    <Text as="p" value={{ es: 'Especializaciones profesionales relacionadas con Java. Las tecnologías mostradas son conexiones con el ecosistema y no una lista completa de requisitos del puesto.', en: 'Professional specializations related to Java. The technologies shown are connections with the ecosystem rather than a complete list of job requirements.' }} />
  </header>
  <div class="java-ecosystem-grid">
    {javaCareerPaths.map(path => <article class="java-career-card" data-java-career={path.id}>
      <Text as="h2" value={path.title} />
      <Text as="p" value={path.focus} />
      <div class="java-career-technologies"><span>Java</span>{path.technologyIds.map(id => <><Icon name="arrow" size={16} /><span>{javaTechnologies.find(technology => technology.id === id)!.name}</span></>)}</div>
      <a href="/java/ecosystem" data-route="java/ecosystem">{t('Ecosystem')}<Icon name="arrow" size={16} /></a>
    </article>)}
  </div>
</section>

<section id="java/developer-roadmap" class="java-path-page" data-resource-route="java/developer-roadmap" data-resource-title="Developer Roadmap" aria-labelledby="java-developer-roadmap-title" hidden>
  <header class="java-path-heading">
    <h1 id="java-developer-roadmap-title">{t('Developer Roadmap')}</h1>
    <Text as="p" value={{ es: 'La secuencia de aprendizaje parte de los fundamentos y avanza hacia frameworks y pruebas. Ecosystem muestra las tecnologías y Career Paths las especializaciones.', en: 'The learning sequence starts with fundamentals and progresses towards frameworks and testing. Ecosystem shows technologies and Career Paths shows specializations.' }} />
  </header>
  <ol class="java-developer-roadmap">
    {javaDeveloperRoadmap.map((stage, index) => <li><span class="java-roadmap-number">{String(index + 1).padStart(2, '0')}</span><Text as="h2" value={stage} />{index < javaDeveloperRoadmap.length - 1 && <Icon name="arrow" size={16} />}</li>)}
  </ol>
  <nav class="java-path-links" aria-label={t('Guías relacionadas')}>
    <a href="/java/ecosystem" data-route="java/ecosystem">{t('Ecosystem')}<Icon name="arrow" size={16} /></a>
    <a href="/java/career-paths" data-route="java/career-paths">{t('Career Paths')}<Icon name="arrow" size={16} /></a>
  </nav>
</section>
