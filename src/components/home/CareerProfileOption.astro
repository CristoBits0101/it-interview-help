---
import { t } from '../../lib/translations';
import Icon from '../Icon.astro';
import type { CareerProfile } from '../../data/career-paths';

interface Props {
  profile: Pick<CareerProfile, 'id' | 'label' | 'purpose'>;
  index: number;
  directionId: string;
  hidden?: boolean;
  selected?: boolean;
  controls?: string;
}
const { profile, index, directionId, hidden = false, selected = false, controls = 'career-panels' } = Astro.props;
const descriptionId = `career-purpose-${profile.id}`;
---
<button type="button" data-carousel-item data-profile-direction={directionId} hidden={hidden} data-career-profile={profile.id} aria-label={t(profile.label)} aria-describedby={descriptionId} aria-pressed={selected} aria-controls={controls}>
  <span class="career-option-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <span class="career-option-copy">
    <span class="career-option-title">{t(profile.label)}</span>
    <span class="career-option-description" id={descriptionId}>{t(profile.purpose)}</span>
  </span>
  <span class="career-selected-mark"><Icon name="check" size={13} /></span>
</button>
