---
import { t } from '../../lib/translations';
import Icon from '../Icon.astro';
import '../../styles/career-carousel.css';

interface Props {
  id: string;
  label: string;
  previousLabel: string;
  nextLabel: string;
  class?: string;
  selection?: boolean;
}
const { id, label, previousLabel, nextLabel, class: className = '', selection = false } = Astro.props;
---
<div class="career-choice-group">
  <div class="career-carousel" data-carousel data-carousel-selection={selection || undefined}>
    <div class="career-carousel-heading">
      <p class="career-control-label" id={`${id}-label`}>{t(label)}</p>
      {selection && <span class="career-carousel-range" data-carousel-range role="status" aria-live="polite" aria-atomic="true"></span>}
    </div>
    <div class="career-carousel-row">
      <div id={id} class:list={['career-carousel-viewport', className]} data-carousel-viewport role="group" aria-labelledby={`${id}-label`}>
        <slot />
      </div>
      <div class="career-carousel-controls" data-carousel-controls hidden>
        <button type="button" data-carousel-previous aria-label={t(previousLabel)} aria-controls={id} disabled><Icon name="chevron" size={16} class="career-carousel-back" /></button>
        {!selection && <span class="career-carousel-range" data-carousel-range role="status" aria-live="polite" aria-atomic="true"></span>}
        <button type="button" data-carousel-next aria-label={t(nextLabel)} aria-controls={id} disabled><Icon name="chevron" size={16} /></button>
      </div>
    </div>
  </div>
</div>
