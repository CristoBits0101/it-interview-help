---
import type { CareerStage } from '../../data/career-paths';

interface Props {
  stage: CareerStage;
  selected: boolean;
  descriptions: Record<string, string>;
}

const { stage, selected, descriptions } = Astro.props;
const terms = stage.terms ?? [stage.label];
const tooltipId = `career-tooltip-${stage.id}`;
---
<li data-career-stage-option>
  <button type="button" data-career-stage={stage.id} aria-label={stage.label} aria-pressed={selected} aria-controls="career-panels" aria-describedby={`${tooltipId} career-experience-${stage.id} career-experience-note`}>
    <span class="career-stage-labels">
      {terms.map(term => <span class="career-stage-term" data-career-term={term}>{term}</span>)}
    </span>
    <span class="career-stage-experience" id={`career-experience-${stage.id}`}>{stage.experience}</span>
  </button>
  <div id={tooltipId} class="career-stage-tooltip" role="tooltip" hidden>
    {terms.map(term => <p data-career-term-description={term}><strong>{term}</strong><span>{descriptions[term]}</span></p>)}
  </div>
</li>
