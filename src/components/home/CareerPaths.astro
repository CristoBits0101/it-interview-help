---
import CareerPanel from './CareerPanel.astro';
import CareerProfileOption from './CareerProfileOption.astro';
import CareerStageOption from './CareerStageOption.astro';
import type { Track } from '../../data/curriculum';
import type { NavigationNode } from '../../data/navigation';
import type { CareerProfile } from '../../data/career-paths';
interface Props { profiles: CareerProfile[]; tracks: Track[]; areas: ReadonlyMap<string, NavigationNode>; guidanceByArea: Record<string, { focus: string; prerequisites: string[] }>; termDescriptions: Record<string, string> }
const { profiles, tracks, areas, guidanceByArea, termDescriptions } = Astro.props;
const stages = profiles[0].stages;
---
<section class="home-section" id="career-paths" aria-labelledby="career-title">
    <header class="home-section-heading">
      <h2 id="career-title">Elige tu Dirección</h2>
    </header>

    <div class="career-profile-options" role="group" aria-label="Perfil profesional">
      {profiles.map((profile, index) => <CareerProfileOption profile={profile} index={index} selected={index === 0} />)}
    </div>

    <div class="career-stage-section">
      <p class="career-control-label" id="career-stage-label">¿En qué etapa quieres trabajar?</p>
      <ol class="career-stage-options" aria-labelledby="career-stage-label">
        {stages.map((stage, index) => <CareerStageOption stage={stage} index={index} selected={index === 0} descriptions={termDescriptions} />)}
      </ol>
    </div>

    <p id="career-selection-status" class="sr-only" role="status" aria-live="polite"></p>
    <div id="career-panels">
      {profiles.map((profile, profileIndex) => profile.stages.map((stage, stageIndex) => <CareerPanel profile={profile} stage={stage} initial={profileIndex === 0 && stageIndex === 0} tracks={tracks} areas={areas} guidanceByArea={guidanceByArea} />))}
    </div>
  </section>
