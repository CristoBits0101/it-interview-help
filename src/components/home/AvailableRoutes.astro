---
import Icon from '../Icon.astro';
import type { Track } from '../../data/curriculum';
import { countConcepts } from '../../lib/catalog';
interface Props { tracks: Track[]; labels: ReadonlyMap<string, string> }
const { tracks, labels } = Astro.props;
---
<section class="home-section" id="available-routes" aria-labelledby="available-title">
    <header class="home-section-heading"><div><p class="home-kicker">03 / PASA A LOS CONCEPTOS</p><h2 id="available-title">Explora las rutas disponibles.</h2></div><p class="available-route-summary" data-route-count={tracks.length}>{tracks.length} rutas disponibles. Definiciones breves y fuentes originales para profundizar.</p></header>
    <div class="home-route-grid">
      {tracks.map((track, index) => <a class="home-route-card" href={`#${track.id}/${track.modules[0].id}`} data-route={track.id}><div class="home-route-meta"><span data-route-number={String(index + 1).padStart(2, '0')}>RUTA {String(index + 1).padStart(2, '0')}</span><Icon name="arrow" size={18} /></div><h3>{labels.get(track.id) ?? track.title}</h3><p><span data-concept-count={countConcepts(track)}>{countConcepts(track)} conceptos</span> <span aria-hidden="true">·</span> <span data-module-count={track.modules.length}>{track.modules.length} {track.modules.length === 1 ? 'módulo' : 'módulos'}</span></p></a>)}
    </div>
  </section>
