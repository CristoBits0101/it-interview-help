---
interface Props { branches: { title: string; description: string; sequence: string[] }[] }
const { branches } = Astro.props;
---
<section class="home-section" aria-labelledby="growth-title">
    <header class="home-section-heading">
      <h2 id="growth-title">Amplía tu Alcance</h2>
    </header>
    <div class="career-branches">
      {branches.map(branch => <article class="career-branch"><h3>{branch.title}</h3><p>{branch.description}</p><ol aria-label={`Recorrido orientativo: ${branch.title}`}>{branch.sequence.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol></article>)}
    </div>
  </section>
