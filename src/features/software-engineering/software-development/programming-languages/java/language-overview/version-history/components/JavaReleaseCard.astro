---
import type { javaSummary } from '../data/java-summary';
import Text from './JavaText.astro';
interface Props { release: typeof javaSummary[number] }
const { release } = Astro.props;
---
<article class="java-version-card" data-java-release={release.number} aria-labelledby={'java-release-' + release.version}>
  <header class="java-card-heading">
    <h2 id={'java-release-' + release.version}>Java {release.version}</h2>
    <span class="java-year">{release.year}</span>
    {release.lts && <span class="java-badge">LTS</span>}
  </header>
  <ul class="java-highlights">
    {release.highlights.map(item => <li><a href={item.source} target="_blank" rel="noopener noreferrer"><Text {...item.title} />{item.status && <span class="java-status"> · <Text {...item.status} /></span>}<span class="sr-only"> · <Text es="Se abre en una pestaña nueva" en="Opens in a new tab" /></span></a></li>)}
  </ul>
</article>
