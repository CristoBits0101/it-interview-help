---
import PageHeading from '../../../../../shared/components/guides/PageHeading.astro';
import { aiEcosystemTools, aiToolCategories, aiToolKinds } from '../data/ai-ecosystem';
import Text from '../../../../../shared/components/primitives/LocalizedText.astro';
import Icon from '../../../../../shared/components/primitives/Icon.astro';
import { t, sourceDescription } from '../../../../../shared/lib/translations';
import '../../../../../shared/styles/reference-content.css';
import '../styles/ai-ecosystem.css';
---
<section id="applied-ai/ecosystem" class="ai-ecosystem-page page-flow" data-resource-route="applied-ai/ecosystem" data-resource-title="AI Ecosystem" aria-labelledby="ai-ecosystem-title" hidden>
  <PageHeading id="ai-ecosystem-title" class="foundation-heading">
    <span slot="title">{t('AI Ecosystem')}</span><Text as="p" value={{ es: 'Herramientas y servicios agrupados por su función. Una misma herramienta puede tener varios usos y el mapa no fija un orden de aprendizaje.', en: 'Tools and services grouped by function. A tool may serve several purposes and the map does not prescribe a learning order.' }} />
  </PageHeading>
  <div class="ai-tool-filters" role="group" aria-label={t('Filtrar herramientas por función')}>
    <button type="button" data-ai-category="all" aria-pressed="true">{t('Todas las funciones')}</button>
    {aiToolCategories.map(category => <button type="button" data-ai-category={category.id} aria-pressed="false"><Text value={category.title} /></button>)}
  </div>
  <p class="sr-only" role="status" aria-live="polite" id="ai-tools-status"></p>
  <div class="ai-tool-grid">
    {aiEcosystemTools.map(tool => <article class="ai-tool-card" data-ai-tool={tool.id} data-ai-categories={tool.uses.map(use => use.category).join(' ')}>
      <h2>{tool.name}</h2><Text as="p" class="ai-tool-kind" value={aiToolKinds[tool.kind]} />
      <ul>{tool.uses.map(use => <li><Text value={aiToolCategories.find(category => category.id === use.category)!.title} />{tool.uses.length > 1 && <span> · {use.label}</span>}</li>)}</ul>
      <a class="ai-tool-source" href={tool.url} target="_blank" rel="noopener noreferrer" aria-label={sourceDescription(tool.name, tool.name, tool.name, 'en')} data-ai-source={tool.name}><Icon name="bulb" size={18} /><span>{t('Documentación')}</span><Icon name="link" size={16} /></a>
    </article>)}
  </div>
</section>
