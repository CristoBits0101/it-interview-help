---
import PageHeading from '../../../shared/components/guides/PageHeading.astro';
import { t } from '../../../shared/lib/translations';
import type { Track } from '../../../shared/lib/curriculum';
import { publishedNavigation as navigation, publishedGuides } from '../../../app/data/published-catalog';
import { careerProfiles, areaGuidance, careerTermDescriptions } from '../data/career-paths';
import { careerGrowthTargets } from '../data/career-growth';
import { careerDirections } from '../data/career-directions';
import HomeStats from './HomeStats.astro';
import CareerPaths from './CareerPaths.astro';
import CareerGrowth from './CareerGrowth.astro';
import { flattenNavigation, countConcepts } from '../../../shared/lib/catalog';
import '../styles/home.css';

interface Props { tracks: Track[]; hidden?: boolean }
const { tracks, hidden = false } = Astro.props;
const catalog = flattenNavigation(navigation);
const areas = new Map(catalog.map(node => [node.label, node]));
const totalConcepts = tracks.reduce((total, track) => total + countConcepts(track), 0);
const stats = [
  { value: navigation.length, label: 'Áreas Principales', detail: 'Temas para repasar' },
  { value: tracks.length + publishedGuides.length, label: 'Rutas con Contenido', detail: 'Disponibles para estudiar' },
  { value: totalConcepts, label: 'Conceptos', detail: 'Breves y conectados' },
  { value: careerProfiles.length, label: 'Perfiles Profesionales', detail: 'Orientación por especialidad' },
];
---

<section id="home-view" aria-labelledby="home-title" hidden={hidden}>
  <PageHeading id="home-title" class="home-introduction">
    <span slot="title">{t('Prepara tu próxima entrevista técnica')}</span>
    <p>{t('Prepara tus procesos de selección con los conocimientos esenciales para tu puesto objetivo centralizados en un solo lugar y respaldados por fuentes verificadas.')}</p>
  </PageHeading>

  <HomeStats stats={stats} />
  <hr class="home-separator" />

  <CareerPaths profiles={careerProfiles} directions={careerDirections} tracks={tracks} areas={areas} guidanceByArea={areaGuidance} termDescriptions={careerTermDescriptions} />
  <hr class="home-separator" />

  <CareerGrowth targets={careerGrowthTargets} initialProfileId={careerProfiles[0].id} />
</section>
