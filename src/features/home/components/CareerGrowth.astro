---
import { t } from '../../../shared/lib/translations';
import type { CareerGrowthTarget } from '../data/career-growth';
import { careerGrowthGroups } from '../data/career-growth';
import { careerGrowthResources } from '../data/career-growth-resources';
import Icon, { type IconName } from '../../../shared/components/primitives/Icon.astro';

interface Props { targets: readonly CareerGrowthTarget[]; initialProfileId: string }
const { targets, initialProfileId } = Astro.props;
const groupIcons: Record<CareerGrowthTarget['group'], IconName> = { specialization: 'target', leadership: 'users', management: 'workflow', executive: 'chart' };
---
<section class="home-section" id="career-growth" aria-labelledby="growth-title">
  <header class="home-section-heading">
    <h2 class="section-title" id="growth-title">{t('Amplía tu Alcance')}</h2>
  </header>
  <p class="career-growth-introduction">{t('Selecciona hacia qué trayectoria profesional quieres progresar.')}</p>
  <div class="career-branches">
    {careerGrowthGroups.map(group => <article class="career-branch" data-growth-group={group.id}>
      <h3 class="career-icon-heading" id={`growth-${group.id}-title`}><Icon name={groupIcons[group.id]} class="career-heading-icon" /><span>{t(group.title)}</span></h3>
      <hr class="career-growth-separator" />
      <p class="career-growth-question" id={`growth-${group.id}-question`}>{t(group.question)}</p>
      <ul class="career-growth-options" aria-labelledby={`growth-${group.id}-title growth-${group.id}-question`}>
        {targets.filter(target => target.group === group.id).map(target => <li data-growth-option hidden={!target.profileIds.includes(initialProfileId)}>
          <a href={careerGrowthResources[target.id].url} target="_blank" rel="noopener noreferrer" hreflang={careerGrowthResources[target.id].language} data-career-growth={target.id} data-growth-profiles={target.profileIds.join(' ')}>
            <span class="career-growth-abbreviation" data-i18n-es={target.abbreviation.es} data-i18n-en={target.abbreviation.en} aria-hidden="true">{target.abbreviation.en}</span>
            <span data-growth-label>{t(target.label)}</span>
            <Icon name="link" size={16} class="career-growth-link-icon" />
            <span class="sr-only"><span translate="no">{careerGrowthResources[target.id].publisher}</span>. <span>{t('Se abre en una pestaña nueva')}</span></span>
          </a>
        </li>)}
      </ul>
    </article>)}
  </div>
</section>
