---
import { t, stageAreaCount, availableConceptCount } from '../../../shared/lib/translations';
import Icon from '../../../shared/components/primitives/Icon.astro';
import type { Track } from '../../../shared/lib/curriculum';
import type { NavigationNode } from '../../../app/data/navigation';
import type { CareerProfile, CareerStage } from '../data/career-paths';
import { countConcepts, firstPublishedDestination } from '../../../shared/lib/catalog';
import { publishedGuides } from '../../../app/data/published-catalog';
interface Props { profile: CareerProfile; stage: CareerStage; initial: boolean; tracks: Track[]; areas: ReadonlyMap<string, NavigationNode>; guidanceByArea: Record<string, { focus: string; prerequisites: string[] }> }
const { profile, stage, initial, tracks, areas, guidanceByArea } = Astro.props;
---
<section class="career-panel" data-career-panel={profile.id} data-stage={stage.id} hidden={!initial} aria-labelledby={`career-heading-${profile.id}-${stage.id}`}>
          <header class="career-panel-heading">
            <div><p class="home-kicker">{t(stage.label)}</p><h3 id={`career-heading-${profile.id}-${stage.id}`}>{t(profile.label)}</h3><p>{t(profile.summary)}</p></div>
            <span class="career-area-count" data-stage-area-count={stage.areas.length}>{stageAreaCount(stage.areas.length, 'en')}</span>
          </header>
          <hr class="home-separator" />
          <div class="career-plan-layout">
            <div class="career-plan-content">
              <p class="career-list-label">{t('Orden sugerido de estudio')} <span>{t('Conserva las bases de etapas anteriores')}</span></p>
              <ol class="career-area-grid">
                {stage.areas.map((label, index) => {
                  const area = areas.get(label);
                  const guidance = guidanceByArea[label];
                  const destination = area ? firstPublishedDestination(area) : undefined;
                  const linkedTrack = destination ? tracks.find(track => destination.startsWith(`#${track.id}/`)) : undefined;
                  const linkedGuide = publishedGuides.some(guide => guide.href === destination);
                  return <li class="career-area-card">
                    <div class="career-area-heading"><span class="career-area-number">{String(index + 1).padStart(2, '0')}</span>
                      <div>{destination && (linkedTrack || linkedGuide) ? <a href={destination.replace(/^#/, '/')} data-route={linkedTrack?.id ?? 'java'}><span data-area-translation={label}>{t(label)}</span><Icon name="arrow" size={14} /></a> : <strong data-area-translation={label}>{t(label)}</strong>}
                        {linkedTrack ? <span class="career-content-status is-available">{availableConceptCount(countConcepts(linkedTrack), 'en')}</span> : <span class="career-content-status">{t(linkedGuide ? 'Guía disponible' : 'Contenido no disponible ahora')}</span>}
                      </div>
                    </div>
                    {guidance && <><p class="career-area-focus">{t(guidance.focus)}</p><hr class="home-separator" /><p class="career-prerequisites"><span>{t('Base previa')}</span><span class="career-prerequisite-list">{guidance.prerequisites.length ? guidance.prerequisites.map((prerequisite, prerequisiteIndex) => <span>{prerequisiteIndex > 0 && ' · '}<span data-area-translation={prerequisite}>{t(prerequisite)}</span></span>) : t('Puedes empezar aquí')}</span></p></>}
                  </li>;
                })}
              </ol>
            </div>
            <div class="career-outcome" role="group" aria-label={t('Objetivo y práctica de esta etapa')}>
              <span class="career-outcome-symbol"><Icon name="target" size={24} /></span>
              <p class="home-kicker">{t('QUÉ DEBERÍAS PODER HACER')}</p>
              <h4>{t(stage.goal)}</h4>
              <hr class="home-separator" />
              <div class="career-milestone"><p>{t('DEMUESTRA LO APRENDIDO')}</p><p>{t(stage.milestone)}</p></div>
              <p class="career-outcome-note">{t('Valora lo que puedes explicar y construir. Comprueba también que puedes mantenerlo. Leer los conceptos es solo el comienzo.')}</p>
            </div>
          </div>
        </section>
