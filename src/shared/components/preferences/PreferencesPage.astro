---
import PageHeading from '../guides/PageHeading.astro';
import LanguageSelector from '../controls/LanguageSelector.astro';
import SoundControls from '../controls/SoundControls.astro';
import Icon from '../primitives/Icon.astro';
import { t } from '../../lib/translations';
import './preferences.css';
interface Props { hidden?: boolean }
const { hidden = true } = Astro.props;
---
<section id="preferences-view" class="page-flow" aria-labelledby="preferences-title" hidden={hidden}>
  <PageHeading id="preferences-title">
    <span slot="title">{t('Ajuste de Preferencias')}</span>
    <p>{t('Configura la aplicación según tus necesidades y gustos.')}</p>
  </PageHeading>
  <div class="preferences-sections">
  <section class="preferences-section" aria-labelledby="preferences-storage-title">
    <h2 id="preferences-storage-title"><Icon name="shield" size={18} />{t('Preferencia')}</h2>
    <div class="preferences-options">
      <label class="storage-save-control" for="storage-save-toggle"><span class="storage-save-indicator"><input id="storage-save-toggle" type="checkbox" role="switch" disabled /><Icon name="check" size={16} /></span>{t('Consentir almacenamiento')}</label>
    </div>
    <p id="storage-saving-status" class="storage-saving-status" role="status" hidden></p>
  </section>
  <section class="preferences-section" aria-labelledby="preferences-language-title">
    <h2 id="preferences-language-title"><Icon name="languages" size={18} />{t('Idioma')}</h2>
    <div class="preferences-options"><LanguageSelector /></div>
  </section>
  <section class="preferences-section" aria-labelledby="preferences-sound-title">
    <h2 id="preferences-sound-title"><Icon name="music" size={18} />{t('Sonido')}</h2>
    <div class="preferences-options"><SoundControls /></div>
  </section>
  </div>
</section>
