---
import { t } from '../../lib/translations';
import PageHeading from '../guides/PageHeading.astro';
interface Props { pages: readonly { label: string; href: string }[] }
const { pages } = Astro.props;
---
{pages.map(page => (
  <section class="page-flow" id={page.href.slice(1)} data-pending-route={page.href.slice(1)} data-pending-title={page.label} aria-labelledby={`${page.href.slice(1)}-title`} hidden>
    <PageHeading id={`${page.href.slice(1)}-title`} titleClass="study-title"><span slot="title">{t(page.label)}</span><p>{t('Contenido en preparación')}</p></PageHeading>
  </section>
))}
