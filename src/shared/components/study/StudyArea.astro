---
import { referenceComparisons } from '../../../app/data/reference-comparisons';
import { publishedGuides } from '../../../app/data/published-catalog';
import { t } from '../../lib/translations';
import Icon from '../primitives/Icon.astro';
import StudySection from './StudySection.astro';
import StudyToolbar from './StudyToolbar.astro';
import PageHeading from '../guides/PageHeading.astro';
import type { Track } from '../../lib/curriculum';
interface Props { tracks: Track[]; purposeModuleIds: ReadonlySet<string>; compactTrackIds: ReadonlySet<string>; patternIds: ReadonlySet<string>; aliases: ReadonlyMap<string, string> }
const { tracks, purposeModuleIds, compactTrackIds, patternIds, aliases } = Astro.props;
const firstModule = tracks[0].modules[0];
---
<section class="study-area page-flow" id="study" aria-labelledby="study-title" hidden>
          <PageHeading id="study-title" titleClass="study-title" descriptionId="study-description"><span slot="title">{t(firstModule.title)}</span><p>{t(firstModule.description)}</p></PageHeading>
          <StudyToolbar count={firstModule.concepts.length} />
          <p id="results-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
          {publishedGuides.map(guide => <div class="java-resource-result" data-resource-result={guide.href.slice(1)} hidden>
            <h2>{t('Guías')}</h2>
            <a href={guide.href.replace(/^#/, '/')} data-route={guide.href.slice(1)}><span>{t(guide.label)}</span></a>
          </div>)}
          {referenceComparisons.map(guide => <div class="java-resource-result" data-resource-result={guide.id} hidden><h2>{t('Guías')}</h2><button class="learning-guide-trigger" type="button" data-open-guide={guide.id} aria-haspopup="dialog" aria-controls={guide.id}>{t(guide.label)}</button></div>)}
          <div id="concept-library">
            {tracks.map((track, ti) => track.modules.map((module, mi) => <StudySection track={track} module={module} index={mi} initial={ti === 0 && mi === 0} showPurpose={purposeModuleIds.has(module.id)} hideEmptyViews={compactTrackIds.has(track.id)} patternIds={patternIds} aliases={aliases} />))}
          </div>
          <div class="empty-state" id="empty-state" hidden><span class="empty-icon"><Icon name="search" size={26} /></span><h2 id="empty-title">{t('No hay conceptos con estos filtros')}</h2><p id="empty-description">{t('Prueba con otra palabra o cambia el nivel seleccionado.')}</p><button class="primary-button" id="clear-filters">{t('Limpiar filtros')}</button></div>
          <div class="module-bottom" id="module-bottom"><a class="next-module" id="next-module" href="/software-design/patrones">{t('Siguiente módulo')}<Icon name="arrow" size={13} /></a></div>
        </section>
