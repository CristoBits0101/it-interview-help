---
import {
  ArrowRight, Languages, Link2, Check, ChevronDown, ChevronRight, Circle,
  Lightbulb, Target, Menu, Copy, Compass, Briefcase, Route, Users, Volume2, VolumeX, SlidersHorizontal,
  Search, X, Zap, Sigma, ChartColumn, CodeXml, Network,
  MousePointerClick, Blocks, Database, Workflow, ShieldCheck, FlaskConical, BrainCircuit,
} from 'lucide-astro';

const icons = {
  brand: CodeXml, languages: Languages, arrow: ArrowRight, link: Link2, check: Check, circle: Circle, dot: Circle,
  chevron: ChevronRight, down: ChevronDown,
  'sound-on': Volume2, 'sound-off': VolumeX, 'sound-settings': SlidersHorizontal,
  bulb: Lightbulb, target: Target, menu: Menu, compass: Compass, briefcase: Briefcase, route: Route, users: Users,
  search: Search, close: X, copy: Copy,
  flash: Zap, sigma: Sigma, chart: ChartColumn, programming: CodeXml,
  cpu: Network, interaction: MousePointerClick, blocks: Blocks, database: Database,
  workflow: Workflow, shield: ShieldCheck, science: FlaskConical, brain: BrainCircuit,
};
export type IconName = keyof typeof icons;
interface Props { name: IconName; size?: number; class?: string; color?: string; strokeWidth?: number }
const { name, size = 20, class: className = '', color, strokeWidth = 1.65 } = Astro.props;
const Glyph = icons[name];
---
<Glyph size={size} class={className} color={color} fill={name === 'dot' ? 'currentColor' : 'none'} stroke-width={strokeWidth} aria-hidden="true" focusable="false" />
