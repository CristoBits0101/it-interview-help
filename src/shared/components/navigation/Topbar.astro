---
import { t } from '../../lib/translations';
import Icon from '../primitives/Icon.astro';
const isPreferences = Astro.url.pathname.replace(/\/$/, '') === '/preferences';

---
<header class="topbar">
        <button class="icon-button mobile-toggle" id="mobile-toggle" aria-label={t('Abrir menú de rutas')} aria-controls="sidebar" aria-expanded="false"><Icon name="menu" /></button>
        <nav class="breadcrumb" aria-label={t('Ruta actual')}><a href="/" data-home-link aria-current={isPreferences ? undefined : 'page'} lang="en">{t('Home')}</a><span class="breadcrumb-path" id="breadcrumb-path" hidden={!isPreferences}>{isPreferences && <><span class="breadcrumb-slash" aria-hidden="true">/</span><span class="breadcrumb-current" aria-current="page">{t('Preferencias')}</span></>}</span></nav>
</header>
