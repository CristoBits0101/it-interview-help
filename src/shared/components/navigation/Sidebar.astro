---
import { t } from '../../lib/translations';
import Icon from '../primitives/Icon.astro';
import SearchControl from '../controls/SearchControl.astro';
import NavigationTree from './NavigationTree.astro';
import type { NavigationNode } from '../../../app/data/navigation';
interface Props { nodes: NavigationNode[] }
const { nodes } = Astro.props;
const isPreferences = Astro.url.pathname.replace(/\/$/, '') === '/preferences';
---
<div class="sidebar" id="sidebar" role="complementary" aria-label={t('Navegación de aprendizaje')}>
      <div class="sidebar-header">
        <a href="/" class="brand" aria-label={t('IT Interview Help. Inicio')} lang="en"><span>{t('IT Interview Help')}</span></a>
        <button class="icon-button sidebar-close" id="sidebar-close" aria-label={t('Cerrar menú de rutas')}><Icon name="close" /></button>
      </div>
      <div class="navigation-section">
        <p class="nav-eyebrow" id="navigation-heading" lang="en" data-i18n-source="FOUNDATIONS BY AREA">{t('FOUNDATIONS BY AREA')}</p>
        <div class="sidebar-search"><SearchControl /></div>
        <nav id="course-navigation" class="course-nav" aria-labelledby="navigation-heading" lang="en">
          <NavigationTree nodes={nodes} />
        </nav>
      </div>
      <footer class="sidebar-preferences">
        <hr class="sidebar-preferences-divider" />
        <a href="/preferences" id="preferences-link" class="preferences-link" aria-current={isPreferences ? 'page' : undefined}><Icon name="settings" size={18} /><span>{t('Preferencias')}</span></a>
      </footer>
    </div>
