---
import { t } from '../../lib/translations';
import Icon from '../primitives/Icon.astro';
import type { NavigationNode } from '../../../app/data/navigation';
interface Props { nodes: NavigationNode[]; depth?: number; parentPath?: string }
const { nodes, depth = 0, parentPath = '' } = Astro.props;
const branchId = (label: string) => [parentPath, encodeURIComponent(label)].filter(Boolean).join('/');
const alphabetical = ['/Development%20Domains', '/Programming%20Languages'].some(group => parentPath.endsWith(group));
---
<ul class:list={['navigation-tree', { 'navigation-root': depth === 0 }]} data-navigation-alphabetical={alphabetical || undefined}>
  {(alphabetical ? [...nodes].sort((a, b) => t(a.label).localeCompare(t(b.label), 'en')) : nodes).map(node => (
    <li class:list={{ 'navigation-described': Boolean(node.description) }}>
      {node.description && (
        <button type="button" class="navigation-description-trigger" aria-label={t(node.label)} data-navigation-description={t(node.description)} />
      )}
      {!node.children?.length && !node.href ? (
        <span class="navigation-row navigation-disabled" aria-disabled="true">
          {depth === 0 && node.icon && <Icon name={node.icon} size={18} class="navigation-icon" />}
          <span class="navigation-label" data-i18n-source={node.label} title={node.shared ? t('Base compartida entre áreas') : undefined}>{t(node.label)}</span>
        </span>
      ) : node.children?.length ? (
        <details class="navigation-branch" data-nav-branch={branchId(node.id ?? node.label)}>
          <summary class="navigation-row">
            {depth === 0 && node.icon && <Icon name={node.icon} size={18} class="navigation-icon" />}
            <span class="navigation-label" data-i18n-source={node.label}>{t(node.label)}</span>
            <Icon name="down" size={14} class="navigation-chevron" />
          </summary>
          <Astro.self nodes={node.children} depth={depth + 1} parentPath={branchId(node.id ?? node.label)} />
        </details>
      ) : (
        <a class="navigation-row navigation-link" href={node.href?.replace(/^#/, '/') } data-nav-link data-nav-module={node.module}>
          {depth === 0 && node.icon && <Icon name={node.icon} size={18} class="navigation-icon" />}
          <span class="navigation-label" data-i18n-source={node.label}>{t(node.label)}</span>
        </a>
      )}
    </li>
  ))}
</ul>
{depth === 0 && <div id="navigation-description-tooltip" class="navigation-description-tooltip" role="tooltip" popover="manual" />}
