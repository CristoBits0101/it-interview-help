---
import '@fontsource-variable/google-sans-flex';
import AppRuntime from '../app/components/AppRuntime.astro';
import NotFoundRuntime from '../app/components/NotFoundRuntime.astro';
import '@fontsource/dancing-script/latin-400.css';
import { t } from '../shared/lib/translations';
import { createRouteTitles, documentTitle } from '../shared/lib/document-title';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../shared/styles/global.css';
import designTokens from '../shared/styles/tokens.css?raw';
import Sidebar from '../shared/components/navigation/Sidebar.astro';
import Topbar from '../shared/components/navigation/Topbar.astro';
import ReviewDialog from '../shared/components/dialogs/ReviewDialog.astro';
import SourcesDialog from '../shared/components/dialogs/SourcesDialog.astro';
import StorageConsentDialog from '../shared/components/preferences/StorageConsentDialog.astro';
import type { NavigationNode } from '../app/data/navigation';
import type { ConceptSource } from '../shared/data/concept-sources';
interface Props { notFound?: boolean; navigation: NavigationNode[]; sources: Pick<ConceptSource, 'title' | 'url'>[] }
const { navigation, sources, notFound = false } = Astro.props;
const isPreferences = Astro.url.pathname.replace(/\/$/, '') === '/preferences';
const defaultDescription = 'Review key concepts and prepare your answers for technical interviews across different roles and companies.';
const description = notFound ? t('No encontramos esta página.') : isPreferences ? t('Configura la aplicación según tus necesidades y gustos.') : defaultDescription;
const routeTitles = createRouteTitles(navigation);
const pageTitle = notFound ? documentTitle('/404', {}, 'en', 'Page Not Found') : documentTitle(Astro.url.pathname, routeTitles, 'en');
const canonicalUrl = notFound ? undefined : isPreferences && Astro.site ? new URL('preferences', Astro.site).href : Astro.site?.href;
const canvasColor = designTokens.match(/--canvas:\s*(#[\da-fA-F]{6})\s*;/)?.[1];
if (!canvasColor) throw new Error('The canvas design token must define a six-digit hex color.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-default-description={defaultDescription} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} data-base-url={Astro.site?.href} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="theme-color" content={canvasColor} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=writing-hand-1" />
    <title data-route-titles={JSON.stringify(routeTitles)}>{pageTitle}</title>
  </head>
  <body lang="en">
    <a href="#main" class="skip-link">{t('Saltar al contenido')}</a>
    <div class="mobile-backdrop" id="mobile-backdrop" hidden></div>
    <Sidebar nodes={navigation} />

    <div class="workspace">
      <Topbar notFound={notFound} />

      <main id="main" tabindex="-1">
        <slot />

        {!notFound && <noscript><p class="noscript-note">{t('Puedes consultar el resumen y el primer itinerario. Activa JavaScript para elegir otro perfil, navegar entre módulos, buscar y guardar tu progreso.')}</p></noscript>}
      </main>
    </div>

    <ReviewDialog />

    <SourcesDialog sources={sources} />
    <StorageConsentDialog />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    {notFound ? <NotFoundRuntime /> : <AppRuntime />}
  </body>
</html>
