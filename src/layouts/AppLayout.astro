---
import '@fontsource-variable/google-sans-flex';
import '@fontsource/dancing-script/latin-400.css';
import { t } from '../lib/translations';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import designTokens from '../styles/tokens.css?raw';
import Sidebar from '../components/layout/Sidebar.astro';
import Topbar from '../components/layout/Topbar.astro';
import ReviewDialog from '../components/dialogs/ReviewDialog.astro';
import SourcesDialog from '../components/dialogs/SourcesDialog.astro';
import type { NavigationNode } from '../data/navigation';
import type { ConceptSource } from '../data/concept-sources';
interface Props { navigation: NavigationNode[]; sources: Pick<ConceptSource, 'title' | 'url'>[] }
const { navigation, sources } = Astro.props;
const canonicalUrl = Astro.site?.href;
const canvasColor = designTokens.match(/--canvas:\s*(#[\da-fA-F]{6})\s*;/)?.[1];
if (!canvasColor) throw new Error('The canvas design token must define a six-digit hex color.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Review key concepts and prepare your answers for technical interviews across different roles and companies." />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="theme-color" content={canvasColor} />
    <meta property="og:title" content="Tech Interview Prep · Foundations for technical interviews" />
    <meta property="og:description" content="Review key concepts and prepare your answers for technical interviews across different roles and companies." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tech Interview Prep · Home</title>
  </head>
  <body lang="en">
    <a href="#main" class="skip-link">{t('Saltar al contenido')}</a>
    <div class="mobile-backdrop" id="mobile-backdrop" hidden></div>
    <Sidebar nodes={navigation} />

    <div class="workspace">
      <Topbar />

      <main id="main" tabindex="-1">
        <slot />

        <noscript><p class="noscript-note">{t('Puedes consultar el resumen y el primer itinerario. Activa JavaScript para elegir otro perfil, navegar entre módulos, buscar y guardar tu progreso.')}</p></noscript>
      </main>
    </div>

    <ReviewDialog />

    <SourcesDialog sources={sources} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/app';</script>
  </body>
</html>
