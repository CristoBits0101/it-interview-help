---
import '@fontsource-variable/google-sans-flex';
import '@fontsource/dancing-script/latin-400.css';
import { t } from '../shared/lib/translations';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../shared/styles/global.css';
import designTokens from '../shared/styles/tokens.css?raw';
import Sidebar from '../shared/components/navigation/Sidebar.astro';
import Topbar from '../shared/components/navigation/Topbar.astro';
import ReviewDialog from '../shared/components/dialogs/ReviewDialog.astro';
import SourcesDialog from '../shared/components/dialogs/SourcesDialog.astro';
import type { NavigationNode } from '../app/data/navigation';
import type { ConceptSource } from '../shared/data/concept-sources';
interface Props { navigation: NavigationNode[]; sources: Pick<ConceptSource, 'title' | 'url'>[] }
const { navigation, sources } = Astro.props;
const isPreferences = Astro.url.pathname.replace(/\/$/, '') === '/preferences';
const defaultDescription = 'Review key concepts and prepare your answers for technical interviews across different roles and companies.';
const description = isPreferences ? t('Personaliza el idioma y los sonidos de la aplicación.') : defaultDescription;
const pageTitle = isPreferences ? `${t('Preferencias')} · IT Interview Help` : 'IT Interview Help · Home';
const canonicalUrl = isPreferences && Astro.site ? new URL('preferences', Astro.site).href : Astro.site?.href;
const canvasColor = designTokens.match(/--canvas:\s*(#[\da-fA-F]{6})\s*;/)?.[1];
if (!canvasColor) throw new Error('The canvas design token must define a six-digit hex color.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-default-description={defaultDescription} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} data-base-url={Astro.site?.href} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="theme-color" content={canvasColor} />
    <meta property="og:title" content={isPreferences ? pageTitle : 'IT Interview Help · Foundations for technical interviews'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body lang="en">
    <a href="#main" class="skip-link">{t('Saltar al contenido')}</a>
    <div class="mobile-backdrop" id="mobile-backdrop" hidden></div>
    <Sidebar nodes={navigation} />

    <div class="workspace">
      <Topbar />

      <main id="main" tabindex="-1">
        <slot />

        <noscript><p class="noscript-note">{t('Puedes consultar el resumen y el primer itinerario. Activa JavaScript para elegir otro perfil, navegar entre módulos, buscar y guardar tu progreso.')}</p></noscript>
      </main>
    </div>

    <ReviewDialog />

    <SourcesDialog sources={sources} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../app/scripts/app';</script>
  </body>
</html>
