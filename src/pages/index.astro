---
import AppLayout from '../layouts/AppLayout.astro';
import SystemDesignSummary from '../features/software-engineering/system-design/components/SystemDesignSummary.astro';
import HomeOverview from '../features/home/components/HomeOverview.astro';
import StudyArea from '../shared/components/study/StudyArea.astro';
import PendingContent from '../shared/components/study/PendingContent.astro';
import FoundationGuide from '../shared/components/guides/FoundationGuide.astro';
import { foundationGuides } from '../app/data/foundation-guides';
import JavaEcosystem from '../features/software-engineering/software-development/programming-languages/java/language-overview/ecosystem/components/JavaEcosystem.astro';
import JavaCareerPaths from '../features/software-engineering/software-development/programming-languages/java/language-overview/career-paths/components/JavaCareerPaths.astro';
import AiEcosystem from '../features/artificial-intelligence/generative-artificial-intelligence/ecosystem/components/AiEcosystem.astro';
import ComparisonDialog from '../shared/components/guides/ComparisonDialog.astro';
import { referenceComparisons } from '../app/data/reference-comparisons';
import JavaVersions from '../features/software-engineering/software-development/programming-languages/java/language-overview/version-history/components/JavaVersions.astro';
import { publishedTracks, publishedNavigation, publishedSources, patternIds, patternModuleIds, glossaryAliases, pendingPages } from '../app/data/published-catalog';

---
<AppLayout navigation={publishedNavigation} sources={publishedSources}>
  <HomeOverview tracks={publishedTracks} />
  <PendingContent pages={pendingPages} />
  <JavaVersions />
  <SystemDesignSummary />
  <AiEcosystem />
  {referenceComparisons.map(guide => <ComparisonDialog guide={guide} />)}
  <JavaEcosystem />
  <JavaCareerPaths />
  {foundationGuides.map(guide => <FoundationGuide guide={guide} />)}
  <StudyArea tracks={publishedTracks} purposeModuleIds={patternModuleIds} compactTrackIds={new Set(['applied-ai'])} patternIds={patternIds} aliases={glossaryAliases} />
</AppLayout>
