---
import AppLayout from '../layouts/AppLayout.astro';
import SystemDesignSummary from '../components/study/SystemDesignSummary.astro';
import HomeOverview from '../components/HomeOverview.astro';
import StudyArea from '../components/study/StudyArea.astro';
import PendingContent from '../components/PendingContent.astro';
import FoundationGuide from '../components/foundations/FoundationGuide.astro';
import { foundationGuides } from '../data/foundation-guides';
import JavaLearningPaths from '../components/java/JavaLearningPaths.astro';
import AiEcosystem from '../components/ai/AiEcosystem.astro';
import ComparisonDialog from '../components/foundations/ComparisonDialog.astro';
import { referenceComparisons } from '../data/reference-comparisons';
import JavaVersions from '../components/java/JavaVersions.astro';
import { publishedTracks, publishedNavigation, publishedSources, patternIds, patternModuleIds, glossaryAliases, pendingPages } from '../data/published-catalog';

---
<AppLayout navigation={publishedNavigation} sources={publishedSources}>
  <HomeOverview tracks={publishedTracks} />
  <PendingContent pages={pendingPages} />
  <JavaVersions />
  <SystemDesignSummary />
  <AiEcosystem />
  {referenceComparisons.map(guide => <ComparisonDialog guide={guide} />)}
  <JavaLearningPaths />
  {foundationGuides.map(guide => <FoundationGuide guide={guide} />)}
  <StudyArea tracks={publishedTracks} purposeModuleIds={patternModuleIds} compactTrackIds={new Set(['applied-ai'])} patternIds={patternIds} aliases={glossaryAliases} />
</AppLayout>
