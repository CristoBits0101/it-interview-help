---
import '@fontsource-variable/google-sans-flex';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import designTokens from '../styles/tokens.css?raw';
import Icon from '../components/Icon.astro';
import NavigationTree from '../components/NavigationTree.astro';
import HomeOverview from '../components/HomeOverview.astro';
import { navigation, type NavigationNode } from '../data/navigation';
import { tracks as coreTracks, type Concept } from '../data/curriculum';
const conceptViews = (concept: Concept) => {
  const views = [
    { id: 'explanation', label: 'Explicación', content: concept.description.trim() },
    { id: 'use-case', label: 'Caso de uso', content: concept.useCase?.trim() ?? '' },
    { id: 'example', label: 'Implementación', content: concept.example?.trim() ?? '' },
  ];
  const initial = views.find(view => view.content);
  return views.map(view => ({ ...view, active: view.id === initial?.id }));
};
const tracks = coreTracks.filter(track => track.id === 'software-design');
const availableTrackIds = new Set(tracks.map(track => track.id));
const isAvailableHref = (href?: string) => Boolean(href && [...availableTrackIds].some(trackId => href.startsWith(`#${trackId}/`)));
const visibleNavigation = (nodes: NavigationNode[]): NavigationNode[] => nodes.map(node => ({
  ...node,
  href: isAvailableHref(node.href) ? node.href : undefined,
  children: node.children ? visibleNavigation(node.children) : undefined,
}));
const navigationForAvailableContent = visibleNavigation(navigation);
const sources = [...new Map(tracks.flatMap(track => track.modules.flatMap(module => module.concepts.map(concept => [concept.source.url, { title: concept.source.title, url: concept.source.url }] as const)))).values()];
const firstTrack = tracks[0];
const firstModule = firstTrack.modules[0];
const canvasColor = designTokens.match(/--canvas:\s*(#[\da-fA-F]{6})\s*;/)?.[1];
if (!canvasColor) throw new Error('The canvas design token must define a six-digit hex color.');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Orienta tu aprendizaje en Frontend, Backend, Full Stack, DevOps y Artificial Intelligence. Áreas relacionadas, etapas profesionales y conceptos para practicar." />
    <meta name="theme-color" content={canvasColor} />
    <meta property="og:title" content="Tech Training · Tu mapa de aprendizaje" />
    <meta property="og:description" content="Elige tu perfil técnico, descubre qué áreas estudiar juntas y avanza desde fundamentos hasta especialización." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tech Training · Home</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <div class="mobile-backdrop" id="mobile-backdrop" hidden></div>
    <div class="sidebar" id="sidebar" role="complementary" aria-label="Navegación de aprendizaje">
      <div class="sidebar-header">
        <a href="#home" class="brand" aria-label="Tech Training. Inicio" lang="en"><span>Tech Training</span></a>
        <button class="icon-button sidebar-close" id="sidebar-close" aria-label="Cerrar menú de rutas"><Icon name="close" /></button>
      </div>
      <div class="navigation-section">
        <p class="nav-eyebrow" id="navigation-heading" lang="en">LEARNING PATHS</p>
        <nav class="course-nav" aria-labelledby="navigation-heading" lang="en">
          <NavigationTree nodes={navigationForAvailableContent} />
        </nav>
      </div>
    </div>

    <div class="workspace">
      <header class="topbar">
        <button class="icon-button mobile-toggle" id="mobile-toggle" aria-label="Abrir menú de rutas" aria-controls="sidebar" aria-expanded="false"><Icon name="menu" /></button>
        <nav class="breadcrumb" aria-label="Ruta actual"><a href="#home" data-home-link aria-current="page" lang="en">Home</a><span class="breadcrumb-path" id="breadcrumb-path" hidden></span></nav>
        <div class="topbar-actions">
          <div class="search-box" role="search" aria-label="Buscar conceptos"><Icon name="search" size={18} /><input id="search" type="search" aria-label="Buscar conceptos" placeholder="Buscar conceptos" autocomplete="off" aria-keyshortcuts="Control+k Meta+k" /><button class="search-clear" id="search-clear" type="button" aria-label="Borrar búsqueda" hidden><Icon name="close" size={15} /></button></div>
        </div>
      </header>

      <main id="main" tabindex="-1">
        <HomeOverview tracks={tracks} />

        <section class="study-area" id="study" aria-labelledby="study-title" hidden>
          <h1 class="sr-only" id="study-title">{firstModule.title}</h1>
          <div class="module-toolbar">
            <p class="concept-count" lang="en"><span id="visible-count">{firstModule.concepts.length}</span> CONCEPTS</p>
            <div class="level-select" role="group" aria-label="Filtrar por nivel">
              <button class="level-step level-previous" id="level-previous" type="button" aria-label="Nivel anterior" disabled><span class="level-step-visual"><Icon name="chevron" size={16} /></span></button>
              <span class="level-current" id="level-current" aria-live="polite" aria-atomic="true">Todos los niveles</span>
              <button class="level-step level-next" id="level-next" type="button" aria-label="Nivel siguiente"><span class="level-step-visual"><Icon name="chevron" size={16} /></span></button>
            </div>
          </div>
          <p id="results-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
          <div id="concept-library">
            {tracks.map((track, ti) => track.modules.map((module, mi) => <section class="concept-section" data-track-id={track.id} data-module-id={module.id} data-module-title={module.title} data-module-description={module.description} data-module-number={String(mi + 1).padStart(2, '0')} data-track-title={track.title} data-track-eyebrow={track.eyebrow} hidden={ti !== 0 || mi !== 0}>
              <h2 class="search-group-heading sr-only">{track.title}<Icon name="chevron" size={13} />{module.title}</h2>
              <div class="concept-grid">{module.concepts.map((concept, ci) => <article class="concept-card" id={`concept-${concept.id}`} data-concept-id={concept.id} data-level={concept.level}>
                <div class="card-top"><div class="card-heading"><span class="concept-number">{String(ci + 1).padStart(2, '0')}</span><h3>{concept.title}</h3></div><span class={`level-badge level-${concept.level.toLowerCase()}`}>{concept.level}</span></div>
                <div class="concept-description" aria-live="polite" aria-atomic="true">
                  {conceptViews(concept).map(view => <div id={`concept-${concept.id}-${view.id}`} data-card-panel={view.id} hidden={!view.active}><p>{view.content}</p></div>)}
                </div>
                <a class="concept-source" href={concept.source.url} target="_blank" rel="noopener noreferrer" title={concept.source.title} aria-label={`${concept.source.publisher}. Fuente original. ${concept.source.title}. Sobre ${concept.title}. Se abre en una pestaña nueva.`}>
                  <Icon name="bulb" size={20} /><span class="source-publisher">{concept.source.publisher}</span><Icon name="link" size={16} />
                </a>
                <div class="card-footer">
                  <div class="card-views" role="group" aria-label={`Contenido de ${concept.title}`}>
                    {conceptViews(concept).map(view => <button type="button" class="card-view-button" data-card-view={view.id} aria-controls={`concept-${concept.id}-${view.id}`} aria-pressed={view.active ? 'true' : 'false'} disabled={!view.content}>{view.label}</button>)}
                  </div>
                  <button type="button" class="learn-button" data-learn={concept.id} aria-pressed="false"><span class="check-circle"><Icon name="check" size={11} /></span><span class="learn-label">Lo entiendo</span></button>
                </div>
              </article>)}</div>
            </section>))}
          </div>
          <div class="empty-state" id="empty-state" hidden><span class="empty-icon"><Icon name="search" size={26} /></span><h2 id="empty-title">No hay conceptos con estos filtros</h2><p id="empty-description">Prueba con otra palabra o cambia el nivel seleccionado.</p><button class="primary-button" id="clear-filters">Limpiar filtros</button></div>
          <div class="module-bottom" id="module-bottom"><a class="next-module" id="next-module" href="#software-design/patrones">Siguiente módulo<Icon name="arrow" size={13} /></a></div>
        </section>

        <noscript><p class="noscript-note">Puedes consultar el resumen y el primer itinerario. Activa JavaScript para elegir otro perfil, navegar entre módulos, buscar y guardar tu progreso.</p></noscript>
      </main>
    </div>

    <dialog class="review-dialog" id="review-dialog" aria-labelledby="review-title">
      <div class="dialog-top"><span class="eyebrow"><Icon name="flash" size={15} /> REPASO ACTIVO</span><button class="icon-button" data-close-dialog aria-label="Cerrar repaso"><Icon name="close" /></button></div>
      <div class="review-progress"><span id="review-position">1 / 5</span><span id="review-category">System Design</span></div>
      <div id="review-question"><p class="review-prompt">¿Cómo se lo explicarías a otra persona?</p><h2 id="review-title"></h2><div id="review-answer" hidden><div class="concept-description" id="review-definition"></div><div id="review-source"></div></div></div>
      <button class="primary-button reveal-button" id="reveal-answer">Mostrar explicación<Icon name="down" size={17} /></button>
      <div class="review-rating" id="review-rating" hidden><button class="secondary-button" id="review-again">Seguir practicando</button><button class="primary-button" id="review-known">Lo entiendo<Icon name="check" size={17} /></button></div>
      <div class="review-complete" id="review-complete" hidden><span class="complete-icon"><Icon name="check" size={30} /></span><h2 id="review-complete-title">Un paso más.</h2><p id="review-summary"></p><button class="primary-button" data-close-dialog>Volver a los conceptos<Icon name="arrow" size={17} /></button></div>
      <p class="review-helper" id="review-helper">Primero recuérdalo. Después, compruébalo.</p>
    </dialog>

    <dialog class="sources-dialog" id="sources-dialog" aria-labelledby="sources-title"><div class="dialog-top"><h2 id="sources-title">Sigue aprendiendo</h2><button class="icon-button" data-close-dialog aria-label="Cerrar fuentes"><Icon name="close" /></button></div><p>Una definición es el comienzo. Profundiza con documentación y referencias originales.</p><div class="source-list">{sources.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<Icon name="arrow" size={17} /></a>)}</div><p class="privacy-note">Tu progreso y el estado del menú se almacenan únicamente en este navegador.</p></dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/app';</script>
  </body>
</html>
