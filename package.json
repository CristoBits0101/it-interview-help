{
  "name": "it-interview-help",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs",
    "check:build": "node --import ./scripts/register-typescript.mjs scripts/check-build.mjs",
    "validate": "pnpm run lint && pnpm run check && pnpm run check:curriculum && pnpm test && pnpm run build && pnpm run check:build",
    "lint": "biome lint . --error-on-warnings",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@sentry/astro": "11.10.0",
    "astro": "7.4.0",
    "lucide-astro": "0.556.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
