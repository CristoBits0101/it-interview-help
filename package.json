{
  "name": "tech-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs",
    "check:build": "node --import ./scripts/register-typescript.mjs scripts/check-build.mjs",
    "validate": "npm run check && npm run check:curriculum && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.0",
    "lucide-astro": "0.556.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8"
}
