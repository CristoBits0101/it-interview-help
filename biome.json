{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "*.mjs",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noInvalidConstructorSuper": "error",
        "noConstAssign": "error"
      },
      "suspicious": {
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDoubleEquals": "error",
        "noDebugger": "error",
        "noAsyncPromiseExecutor": "error"
      },
      "security": {
        "noGlobalEval": "error"
      }
    }
  }
}
